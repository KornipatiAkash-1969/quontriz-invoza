// Prisma Schema for AI-Powered OCR Invoice Processing System
// Supports PostgreSQL with Prisma ORM, foreign keys, indexes, cascades, and Decimal NUMERIC types

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  employee
  owner
  admin
}

enum InvoiceStatus {
  Draft
  Pending_Approval @map("Pending Approval")
  Approved
  Paid
  Rejected
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             UserRole  @default(employee)
  createdAt        DateTime  @default(now()) @map("created_at")

  createdInvoices  Invoice[] @relation("InvoiceCreator")
  approvedInvoices Invoice[] @relation("InvoiceApprover")

  @@map("users")
}

model Vendor {
  id          Int       @id @default(autoincrement())
  companyName String    @map("company_name")
  legalName   String?   @map("legal_name")
  vendorType  String?   @default("General Supplier") @map("vendor_type")
  gstin       String?   @unique
  address     String?
  state       String?
  stateCode   String?   @map("state_code")
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  invoices    Invoice[]

  @@index([companyName])
  @@index([gstin])
  @@map("vendors")
}

model Buyer {
  id              Int       @id @default(autoincrement())
  companyName     String    @map("company_name")
  gstin           String?
  billingAddress  String?   @map("billing_address")
  shippingAddress String?   @map("shipping_address")
  createdAt       DateTime  @default(now()) @map("created_at")

  invoices        Invoice[]

  @@index([companyName])
  @@map("buyers")
}

model Category {
  id           Int           @id @default(autoincrement())
  categoryName String        @unique @map("category_name")
  createdAt    DateTime      @default(now()) @map("created_at")

  items        InvoiceItem[]

  @@map("categories")
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  vendorId           Int?          @map("vendor_id")
  buyerId            Int?          @map("buyer_id")
  invoiceNumber      String        @map("invoice_number")
  invoiceDate        DateTime?     @map("invoice_date")
  dueDate            DateTime?     @map("due_date")
  poNumber           String?       @map("po_number")
  placeOfSupply      String?       @map("place_of_supply")
  currency           String        @default("INR")
  paymentTerms       String?       @map("payment_terms")
  
  // Financial amounts stored as PostgreSQL Decimal (NUMERIC)
  subtotal           Decimal       @default(0.0) @db.Decimal(14, 2)
  discount           Decimal       @default(0.0) @db.Decimal(14, 2)
  taxableAmount      Decimal       @default(0.0) @map("taxable_amount") @db.Decimal(14, 2)
  cgst               Decimal       @default(0.0) @db.Decimal(14, 2)
  sgst               Decimal       @default(0.0) @db.Decimal(14, 2)
  igst               Decimal       @default(0.0) @db.Decimal(14, 2)
  otherCharges       Decimal       @default(0.0) @map("other_charges") @db.Decimal(14, 2)
  roundOff           Decimal       @default(0.0) @map("round_off") @db.Decimal(14, 2)
  totalGst           Decimal       @default(0.0) @map("total_gst") @db.Decimal(14, 2)
  grandTotal         Decimal       @map("grand_total") @db.Decimal(14, 2)
  amountPaid         Decimal       @default(0.0) @map("amount_paid") @db.Decimal(14, 2)
  outstandingBalance Decimal       @default(0.0) @map("outstanding_balance") @db.Decimal(14, 2)
  totalAmountInWords String?       @map("total_amount_in_words")

  // Documents and extraction logs
  pdfPath            String?       @map("pdf_path")
  ocrText            String?       @map("ocr_text")
  status             InvoiceStatus @default(Pending_Approval)
  
  // Payment tracking
  paymentMethod      String?       @map("payment_method")
  paymentReference   String?       @map("payment_reference")
  paidAt             DateTime?     @map("paid_at")
  paymentNotes       String?       @map("payment_notes")

  // Audit relationships
  createdByUserId    Int?          @map("created_by_user_id")
  approvedByUserId   Int?          @map("approved_by_user_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  vendor             Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  buyer              Buyer?        @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  createdBy          User?         @relation("InvoiceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy         User?         @relation("InvoiceApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  items              InvoiceItem[]

  @@index([vendorId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id                       Int       @id @default(autoincrement())
  invoiceId                Int       @map("invoice_id")
  lineNumber               Int?      @map("line_number")
  itemName                 String    @map("item_name")
  itemDescription          String?   @map("item_description")
  sku                      String?
  hsnCode                  String?   @map("hsn_code")

  // Dynamic Units and Quantities with PostgreSQL Decimal (NUMERIC)
  quantity                 Decimal   @default(1.0) @db.Decimal(14, 4)
  unitOriginal             String?   @map("unit_original")
  unitNormalized           String?   @map("unit_normalized")
  unitPrice                Decimal   @default(0.0) @map("unit_price") @db.Decimal(14, 4)
  priceUnitQuantity        Decimal   @default(1.0) @map("price_unit_quantity") @db.Decimal(14, 4)
  priceUnitMeasure         String?   @map("price_unit_measure")

  // Financial breakdown
  discountAmount           Decimal   @default(0.0) @map("discount_amount") @db.Decimal(14, 2)
  taxableValue             Decimal   @default(0.0) @map("taxable_value") @db.Decimal(14, 2)
  gstRate                  Decimal   @default(0.0) @map("gst_rate") @db.Decimal(6, 2)
  cgstAmount               Decimal   @default(0.0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount               Decimal   @default(0.0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount               Decimal   @default(0.0) @map("igst_amount") @db.Decimal(14, 2)
  lineTotal                Decimal   @map("line_total") @db.Decimal(14, 2)

  // Validation & AI Flags
  calculationValid         Boolean   @default(true) @map("calculation_valid")
  unitFlagged              Boolean   @default(false) @map("unit_flagged")
  classificationConfidence Float     @default(1.0) @map("classification_confidence")
  
  categoryId               Int?      @map("category_id")
  createdAt                DateTime  @default(now()) @map("created_at")

  invoice                  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category                 Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([itemName])
  @@index([categoryId])
  @@map("invoice_items")
}

model AiExtractionLog {
  id           Int      @id @default(autoincrement())
  invoiceId    Int?     @map("invoice_id")
  engine       String   // "gemini" | "openai" | "smart_native" | "tesseract"
  rawText      String?  @map("raw_text")
  aiResponse   String?  @map("ai_response")
  warnings     String?  // JSON stringified warnings array
  latencyMs    Int?     @map("latency_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("ai_extraction_logs")
}
