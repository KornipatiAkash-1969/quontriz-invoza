# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# PostgreSQL Database Connection URL
# Format: postgres://username:password@host:port/database_name
# For Render Managed PostgreSQL: Paste the External Database URL from Render Dashboard
DATABASE_URL=postgres://quontriz_user:your_password@localhost:5432/quontriz_invoza

# Classification Threshold
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o

# Gmail SMTP Configuration for Real OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Quontriz Invoza" <your_email@gmail.com>
